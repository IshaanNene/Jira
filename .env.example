# Local development configuration. Copy to .env (make dev does this for you).
# Every value here is a development placeholder — none of them is a real secret,
# and none may be used outside a developer machine.

ENVIRONMENT=development
LOG_FORMAT=pretty
PRODUCT_NAME=Meridian

# --- infrastructure (docker-compose.yml) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54320
REDIS_URL=redis://127.0.0.1:63790
TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:54320/postgres
# Event bus. Unset (or OUTBOX_RELAY=hold) runs without it: events wait in each outbox.
KAFKA_BROKERS=127.0.0.1:59092
OPENSEARCH_URL=http://127.0.0.1:59200
# Analytics facts. Three users (docker-compose.yml): migrations, the ingester, dashboard reads.
CLICKHOUSE_URL=http://127.0.0.1:58123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_OWNER_USER=analytics_owner
CLICKHOUSE_OWNER_PASSWORD=analytics_owner
CLICKHOUSE_WRITER_USER=analytics_writer
CLICKHOUSE_WRITER_PASSWORD=analytics_writer
CLICKHOUSE_READER_USER=analytics_reader
CLICKHOUSE_READER_PASSWORD=analytics_reader
# Outgoing email (notification-service, and identity-service for verification and password reset links).
# Locally Mailpit catches everything (inbox: http://localhost:58025).
# Production: smtps://user:password@smtp.example.com:465 (or smtp://…?tls=required).
SMTP_URL=smtp://127.0.0.1:51025
EMAIL_FROM="Meridian <notifications@meridian.localhost>"
# Links in emails point here.
APP_URL=http://localhost:5173

# --- attachments (SeaweedFS S3 API from docker-compose.yml; development credentials) ---
S3_ENDPOINT=http://127.0.0.1:58333
S3_BUCKET=attachments
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=dev-access-key
S3_SECRET_ACCESS_KEY=dev-secret-key

# --- tokens ---
# Must equal the public origin clients use (the gateway).
TOKEN_ISSUER=http://localhost:8080
JWKS_URL=http://127.0.0.1:8101/api/v1/auth/.well-known/jwks.json
# Shared by platform services to authenticate internal gRPC (>= 32 chars).
INTERNAL_SERVICE_SECRET=dev-only-internal-service-secret-0000000000
# base64 of 32 bytes; seals signing keys at rest. Production: from KMS / External Secrets.
IDENTITY_KEY_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWVuY3J5cHRpb24ta2V5LTAwMDA=

# --- browser-facing ---
WEB_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# false only because local development is plain http.
COOKIE_SECURE=false
# true when running behind the gateway, which appends the client address.
TRUST_FORWARDED_FOR=true

# --- internal addresses ---
TENANT_SERVICE_GRPC_URL=http://127.0.0.1:9102
USER_SERVICE_GRPC_URL=http://127.0.0.1:9103
PERMISSION_SERVICE_GRPC_URL=http://127.0.0.1:9108
PROJECT_SERVICE_GRPC_URL=http://127.0.0.1:9104
WORKFLOW_SERVICE_GRPC_URL=http://127.0.0.1:9106
ISSUE_SERVICE_GRPC_URL=http://127.0.0.1:9105
DEFAULT_REGION=local-1

# --- telemetry (optional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# --- web ---
VITE_PRODUCT_NAME=Meridian
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Emails wait this long so reading a notification in the app first cancels it (production: 60).
EMAIL_DELAY_SECONDS=10
